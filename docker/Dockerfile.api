# Dev/test engine image only — not a deployment artifact. Polaris ships as the
# desktop app; there is no server image to deploy (#842).
#
# Builds the single-process local engine (FastAPI + SQLite + in-process task
# queue and scheduler) for:
#   - the desktop smoke/e2e "engine in docker" mode
#     (POLARIS_DESKTOP_ENGINE=docker:polaris-api-test:local:<abs path to src/backend>)
#   - `make golden-record`
# Build it with: make engine-image (tag polaris-api-test:local)
#
# 基于共享 TeX 基础镜像（tectonic + TeX Live + 中文字体，见 Dockerfile.texbase），
# 本文件只做 pip 依赖 + 源码拷贝。
ARG TEXBASE_IMAGE=polaris-texbase:latest
FROM ${TEXBASE_IMAGE}

WORKDIR /srv/backend
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# pip 索引镜像：内网访问官方 PyPI 慢/不稳时传国内源（如清华），默认空=官方源
ARG PIP_INDEX_URL=""
COPY src/backend/pyproject.toml ./
# Install the dependency layer first (cache-friendly), then copy the source
RUN pip install ${PIP_INDEX_URL:+-i $PIP_INDEX_URL} --upgrade pip \
    && pip install ${PIP_INDEX_URL:+-i $PIP_INDEX_URL} -e . || true
COPY src/backend/ ./
RUN pip install ${PIP_INDEX_URL:+-i $PIP_INDEX_URL} -e .

EXPOSE 8000
# Same start sequence as the desktop engine launcher: migrate, then serve.
CMD ["sh", "-c", "python -m alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
