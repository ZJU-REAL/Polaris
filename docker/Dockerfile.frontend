# ---- build ----
FROM node:22-alpine AS build
# packageManager in the root package.json pins the pnpm version for corepack.
RUN corepack enable
WORKDIR /srv
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY src/frontend/package.json src/frontend/
RUN pnpm install --frozen-lockfile --filter ./src/frontend
COPY src/frontend/ src/frontend/
WORKDIR /srv/src/frontend
RUN pnpm run build

# ---- serve ----
FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/src/frontend/dist /usr/share/nginx/html
EXPOSE 80
